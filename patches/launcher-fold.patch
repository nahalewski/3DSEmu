+-- FOLD (LauncherView.fold, set by the Android foldable layer while the
+-- launcher sits in the 3DS bottom screen): no wordmark, and one header row
+-- -- the game dropdown and the tabs in a strip that scrolls left and right
+-- by dragging, with sync / settings / quit pinned to its right.
+local function foldHeaderMetrics(m)
+  local tabW, dropW, labelH = headerTabMetrics(m)
+  local gap = math.floor(6 * m.s)
+  local clusterN = 3
+  local clusterW = clusterN * m.chip + (clusterN - 1) * gap
+  local rowH = m.chip + labelH + math.floor(3 * m.s)
+  return tabW, dropW, labelH, gap, clusterW, rowH
+end
+
+local function foldHeaderHeight(m)
+  local _, _, _, _, _, rowH = foldHeaderMetrics(m)
+  return m.railH + math.floor(6 * m.s) + rowH + math.floor(6 * m.s) + 1
+end
+
+-- a tab's caption, scaled down to its width when it would run over
+local function foldLabel(text, x, y, w, color)
+  local tw = Kit.textWidth("micro", text)
+  if tw <= w or tw <= 0 then
+    Kit.textCenter("micro", text, x, y, w, color)
+    return
+  end
+  local k = w / tw
+  love.graphics.push()
+  love.graphics.translate(x, y + Kit.textHeight("micro") * (1 - k) / 2)
+  love.graphics.scale(k, k)
+  Kit.text("micro", text, 0, 0, color)
+  love.graphics.pop()
+end
+
+local function buildFoldHeader(imp, m)
