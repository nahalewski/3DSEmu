+    local minTab = math.max(Kit.tapMin(), math.floor(m.chip * 0.8))
+    local g = math.max(2, math.floor(gap * 0.6))
+    local k = clusterOut and (avail - n * g) / (dropW + n * tabW)
+      or (avail - (n + 3) * g) / (dropW + n * tabW + 3 * cb)
+    tabW = math.max(minTab, math.floor(tabW * k))
