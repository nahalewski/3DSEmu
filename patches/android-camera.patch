+// The foldable layer's camera (fold3ds/camera.lua).  Android only; elsewhere
+// every command returns nil.
+//   foldCamera("available")          -> bit 0 rear, bit 1 front
+//   foldCamera("start", facing, w)   -> state (0 off, 1 asking, 2 opening,
+//                                       3 running, <0 failed / none / refused)
+//   foldCamera("state") -> state;  foldCamera("stop")
+//   foldCamera("info")  -> width, height, rotation, mirror, serial
+//   foldCamera("frame", imageData)   -> true when a new frame was written
+//                                       (an rgba8 ImageData of that size)
+int w_foldCamera(lua_State *L)
+{
+	const char *cmd = luaL_checkstring(L, 1);
+#ifdef LOVE_ANDROID
+	if (strcmp(cmd, "available") == 0)
+	{
+		lua_pushinteger(L, love::android::foldCameraAvailable());
+		return 1;
+	}
+	if (strcmp(cmd, "start") == 0)
+	{
+		lua_pushinteger(L, love::android::foldCameraStart((int) luaL_optinteger(L, 2, 0),
+			(int) luaL_optinteger(L, 3, 960)));
+		return 1;
+	}
+	if (strcmp(cmd, "state") == 0)
+	{
+		lua_pushinteger(L, love::android::foldCameraState());
+		return 1;
+	}
+	if (strcmp(cmd, "stop") == 0)
+	{
+		love::android::foldCameraStop();
+		return 0;
+	}
+	if (strcmp(cmd, "info") == 0)
+	{
+		int info[5] = { 0, 0, 0, 0, 0 };
+		if (!love::android::foldCameraInfo(info))
+			return 0;
+		for (int i = 0; i < 5; i++)
+			lua_pushinteger(L, info[i]);
+		return 5;
+	}
+	if (strcmp(cmd, "frame") == 0)
+	{
+		love::image::ImageData *d = luax_checktype<love::image::ImageData>(L, 2);
+		bool ok = false;
+		if (d->getFormat() == PIXELFORMAT_RGBA8)
+		{
+			love::thread::Lock lock(d->getMutex());
+			ok = love::android::foldCameraFrame((unsigned char *) d->getData(),
+				d->getWidth(), d->getHeight());
+		}
+		luax_pushboolean(L, ok);
+		return 1;
+	}
+#else
+	LOVE_UNUSED(cmd);
+#endif
+	return 0;
+}
