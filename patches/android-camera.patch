+// ---- the foldable layer's camera (fold3ds)
+
+static jclass foldCameraClass(JNIEnv *env)
+{
+	jclass c = env->FindClass("org/love2d/android/FoldCamera");
+	if (c != nullptr)
+		return c;
+	env->ExceptionClear();
+	// a thread without the app's class loader: ask the activity's
+	void *rawActivity = SDL_AndroidGetActivity();
+	if (rawActivity == nullptr)
+		return nullptr;
+	jobject act = (jobject) rawActivity;
+	jclass actClass = env->GetObjectClass(act);
+	jmethodID getLoader = env->GetMethodID(actClass, "getClassLoader", "()Ljava/lang/ClassLoader;");
+	jobject loader = getLoader ? env->CallObjectMethod(act, getLoader) : nullptr;
+	env->DeleteLocalRef(actClass);
+	env->DeleteLocalRef(act);
+	if (loader == nullptr)
+	{
+		env->ExceptionClear();
+		return nullptr;
+	}
+	jclass loaderClass = env->FindClass("java/lang/ClassLoader");
+	jmethodID loadClass = env->GetMethodID(loaderClass, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;");
+	jstring name = env->NewStringUTF("org.love2d.android.FoldCamera");
+	c = (jclass) env->CallObjectMethod(loader, loadClass, name);
+	env->DeleteLocalRef(name);
+	env->DeleteLocalRef(loaderClass);
+	env->DeleteLocalRef(loader);
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		return nullptr;
+	}
+	return c;
+}
+
+static int foldCameraInt(const char *name, const char *sig, int a = 0, int b = 0)
+{
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldCameraClass(env);
+	if (c == nullptr)
+		return -1;
+	jmethodID m = env->GetStaticMethodID(c, name, sig);
+	int result = -1;
+	if (m == nullptr)
+		env->ExceptionClear();
+	else if (strcmp(sig, "()I") == 0)
+		result = env->CallStaticIntMethod(c, m);
+	else
+		result = env->CallStaticIntMethod(c, m, (jint) a, (jint) b);
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		result = -1;
+	}
+	env->DeleteLocalRef(c);
+	return result;
+}
+
+int foldCameraAvailable()
+{
+	int r = foldCameraInt("available", "()I");
+	return r < 0 ? 0 : r;
+}
+
+int foldCameraStart(int facing, int width)
+{
+	return foldCameraInt("start", "(II)I", facing, width);
+}
+
+int foldCameraState()
+{
+	return foldCameraInt("state", "()I");
+}
+
+void foldCameraStop()
+{
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldCameraClass(env);
+	if (c == nullptr)
+		return;
+	jmethodID m = env->GetStaticMethodID(c, "stop", "()V");
+	if (m != nullptr)
+		env->CallStaticVoidMethod(c, m);
+	env->ExceptionClear();
+	env->DeleteLocalRef(c);
+}
+
+bool foldCameraInfo(int info[5])
+{
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldCameraClass(env);
+	if (c == nullptr)
+		return false;
+	bool ok = false;
+	jmethodID m = env->GetStaticMethodID(c, "info", "()[I");
+	jintArray arr = m ? (jintArray) env->CallStaticObjectMethod(c, m) : nullptr;
+	if (env->ExceptionCheck())
+		env->ExceptionClear();
+	else if (arr != nullptr && env->GetArrayLength(arr) >= 5)
+	{
+		jint v[5];
+		env->GetIntArrayRegion(arr, 0, 5, v);
+		for (int i = 0; i < 5; i++)
+			info[i] = (int) v[i];
+		ok = true;
+	}
+	if (arr != nullptr)
+		env->DeleteLocalRef(arr);
+	env->DeleteLocalRef(c);
+	return ok;
+}
+
+static inline unsigned char clampByte(int v)
+{
+	return (unsigned char) (v < 0 ? 0 : (v > 255 ? 255 : v));
+}
+
+bool foldCameraFrame(unsigned char *rgba, int width, int height)
+{
+	if (rgba == nullptr || width <= 0 || height <= 0 || (width & 1) || (height & 1))
+		return false;
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldCameraClass(env);
+	if (c == nullptr)
+		return false;
+	jmethodID m = env->GetStaticMethodID(c, "frame", "()[B");
+	jbyteArray arr = m ? (jbyteArray) env->CallStaticObjectMethod(c, m) : nullptr;
+	env->DeleteLocalRef(c);
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		return false;
+	}
+	if (arr == nullptr)
+		return false;
+	const int cw = width / 2, ch = height / 2;
+	const jsize need = (jsize) (width * height + 2 * cw * ch);
+	bool ok = false;
+	if (env->GetArrayLength(arr) == need)
+	{
+		jbyte *yuv = env->GetByteArrayElements(arr, nullptr);
+		if (yuv != nullptr)
+		{
+			const unsigned char *Y = (const unsigned char *) yuv;
+			const unsigned char *U = Y + width * height;
+			const unsigned char *V = U + cw * ch;
+			// full-range BT.601 (the camera's JFIF YUV), 10-bit fixed point
+			for (int y = 0; y < height; y++)
+			{
+				const unsigned char *yr = Y + y * width;
+				const unsigned char *ur = U + (y >> 1) * cw;
+				const unsigned char *vr = V + (y >> 1) * cw;
+				unsigned char *o = rgba + (size_t) y * width * 4;
+				for (int x = 0; x < width; x++)
+				{
+					int yy = yr[x] << 10;
+					int u = ur[x >> 1] - 128, v = vr[x >> 1] - 128;
+					o[0] = clampByte((yy + 1436 * v) >> 10);
+					o[1] = clampByte((yy - 352 * u - 731 * v) >> 10);
+					o[2] = clampByte((yy + 1815 * u) >> 10);
+					o[3] = 255;
+					o += 4;
+				}
+			}
+			env->ReleaseByteArrayElements(arr, yuv, JNI_ABORT);
+			ok = true;
+		}
+	}
+	env->DeleteLocalRef(arr);
+	return ok;
+}
+
+static jclass foldClass(JNIEnv *env, const char *slashName, const char *dotName)
+{
+	jclass c = env->FindClass(slashName);
+	if (c != nullptr)
+		return c;
+	env->ExceptionClear();
+	void *rawActivity = SDL_AndroidGetActivity();
+	if (rawActivity == nullptr)
+		return nullptr;
+	jobject act = (jobject) rawActivity;
+	jclass actClass = env->GetObjectClass(act);
+	jmethodID getLoader = env->GetMethodID(actClass, "getClassLoader", "()Ljava/lang/ClassLoader;");
+	jobject loader = getLoader ? env->CallObjectMethod(act, getLoader) : nullptr;
+	env->DeleteLocalRef(actClass);
+	env->DeleteLocalRef(act);
+	if (loader == nullptr)
+	{
+		env->ExceptionClear();
+		return nullptr;
+	}
+	jclass loaderClass = env->FindClass("java/lang/ClassLoader");
+	jmethodID loadClass = env->GetMethodID(loaderClass, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;");
+	jstring name = env->NewStringUTF(dotName);
+	c = (jclass) env->CallObjectMethod(loader, loadClass, name);
+	env->DeleteLocalRef(name);
+	env->DeleteLocalRef(loaderClass);
+	env->DeleteLocalRef(loader);
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		return nullptr;
+	}
+	return c;
+}
+
+int foldRecorderStart(const char *path, int width, int height, int fps)
+{
+	if (path == nullptr)
+		return -1;
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldClass(env, "org/love2d/android/FoldRecorder", "org.love2d.android.FoldRecorder");
+	if (c == nullptr)
+		return -1;
+	int result = -1;
+	jmethodID m = env->GetStaticMethodID(c, "start", "(Ljava/lang/String;III)I");
+	if (m != nullptr)
+	{
+		jstring jpath = env->NewStringUTF(path);
+		result = env->CallStaticIntMethod(c, m, jpath, (jint) width, (jint) height, (jint) fps);
+		env->DeleteLocalRef(jpath);
+	}
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		result = -1;
+	}
+	env->DeleteLocalRef(c);
+	return result;
+}
+
+int foldRecorderState()
+{
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldClass(env, "org/love2d/android/FoldRecorder", "org.love2d.android.FoldRecorder");
+	if (c == nullptr)
+		return -1;
+	jmethodID m = env->GetStaticMethodID(c, "state", "()I");
+	int result = m ? env->CallStaticIntMethod(c, m) : -1;
+	if (env->ExceptionCheck())
+	{
+		env->ExceptionClear();
+		result = -1;
+	}
+	env->DeleteLocalRef(c);
+	return result;
+}
+
+bool foldRecorderFrame(const unsigned char *rgba, int width, int height)
+{
+	if (rgba == nullptr || width <= 0 || height <= 0 || (width & 1) || (height & 1))
+		return false;
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldClass(env, "org/love2d/android/FoldRecorder", "org.love2d.android.FoldRecorder");
+	if (c == nullptr)
+		return false;
+	jmethodID m = env->GetStaticMethodID(c, "frame", "([B)Z");
+	if (m == nullptr)
+	{
+		env->ExceptionClear();
+		env->DeleteLocalRef(c);
+		return false;
+	}
+	const int cw = width / 2, ch = height / 2;
+	const jsize size = (jsize) (width * height + 2 * cw * ch);
+	jbyteArray arr = env->NewByteArray(size);
+	bool ok = false;
+	if (arr != nullptr)
+	{
+		jbyte *out = env->GetByteArrayElements(arr, nullptr);
+		if (out != nullptr)
+		{
+			unsigned char *Y = (unsigned char *) out;
+			unsigned char *U = Y + width * height;
+			unsigned char *V = U + cw * ch;
+			// BT.601 limited range (what H.264 players expect), 8-bit fixed point
+			for (int y = 0; y < height; y++)
+			{
+				const unsigned char *p = rgba + (size_t) y * width * 4;
+				unsigned char *yr = Y + y * width;
+				for (int x = 0; x < width; x++, p += 4)
+					yr[x] = (unsigned char) (((66 * p[0] + 129 * p[1] + 25 * p[2] + 128) >> 8) + 16);
+			}
+			for (int y = 0; y < ch; y++)
+			{
+				for (int x = 0; x < cw; x++)
+				{
+					// the average of the 2 x 2 block
+					const unsigned char *a = rgba + ((size_t) (2 * y) * width + 2 * x) * 4;
+					const unsigned char *b = a + (size_t) width * 4;
+					int r = (a[0] + a[4] + b[0] + b[4]) >> 2;
+					int g = (a[1] + a[5] + b[1] + b[5]) >> 2;
+					int bl = (a[2] + a[6] + b[2] + b[6]) >> 2;
+					U[y * cw + x] = (unsigned char) (((-38 * r - 74 * g + 112 * bl + 128) >> 8) + 128);
+					V[y * cw + x] = (unsigned char) (((112 * r - 94 * g - 18 * bl + 128) >> 8) + 128);
+				}
+			}
+			env->ReleaseByteArrayElements(arr, out, 0);
+			ok = env->CallStaticBooleanMethod(c, m, arr);
+			if (env->ExceptionCheck())
+			{
+				env->ExceptionClear();
+				ok = false;
+			}
+		}
+		env->DeleteLocalRef(arr);
+	}
+	env->DeleteLocalRef(c);
+	return ok;
+}
+
+bool foldRecorderStop(bool toGallery, std::string &uri)
+{
+	JNIEnv *env = (JNIEnv*) SDL_AndroidGetJNIEnv();
+	jclass c = foldClass(env, "org/love2d/android/FoldRecorder", "org.love2d.android.FoldRecorder");
+	if (c == nullptr)
+		return false;
+	bool ok = false;
+	jmethodID m = env->GetStaticMethodID(c, "stop", "(Z)Ljava/lang/String;");
+	jstring result = m ? (jstring) env->CallStaticObjectMethod(c, m, (jboolean) toGallery) : nullptr;
+	if (env->ExceptionCheck())
+		env->ExceptionClear();
+	else if (result != nullptr)
+	{
+		const char *chars = env->GetStringUTFChars(result, nullptr);
+		uri = chars ? chars : "";
+		if (chars)
+			env->ReleaseStringUTFChars(result, chars);
+		ok = true;
+	}
+	if (result != nullptr)
+		env->DeleteLocalRef(result);
+	env->DeleteLocalRef(c);
+	return ok;
+}
